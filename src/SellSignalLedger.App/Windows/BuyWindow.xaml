<Window x:Class="SellSignalLedger.App.Windows.BuyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Buy" SizeToContent="Height" Width="380" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="20">
        <TextBlock Text="Buy" Style="{StaticResource HeadingText}"/>

        <Label Content="TICKER"/>
        <TextBox x:Name="TickerBox"/>

        <Label Content="QUANTITY (WHOLE SHARES)"/>
        <TextBox x:Name="QuantityBox"/>

        <Label Content="PRICE PER SHARE"/>
        <TextBox x:Name="PriceBox"/>

        <Label Content="BUY DATE"/>
        <DatePicker x:Name="PurchaseDatePicker"/>

        <TextBlock x:Name="CostPreview" Foreground="{StaticResource InkSoftBrush}" Margin="0,0,0,10"/>

        <Label Content="MUST SELL % (LEAVE BLANK FOR DEFAULT)"/>
        <TextBox x:Name="MustSellBox"/>

        <Label Content="SELL PROFIT % (LEAVE BLANK FOR DEFAULT)"/>
        <TextBox x:Name="SellProfitBox"/>

        <Label Content="SELL DROP PROFIT % (LEAVE BLANK FOR DEFAULT)"/>
        <TextBox x:Name="SellDropProfitBox"/>

        <TextBlock x:Name="ErrorText" Foreground="{StaticResource LossBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Foreground="White" Click="Cancel_Click"/>
            <Button Content="Buy" Foreground="White" Click="Buy_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
