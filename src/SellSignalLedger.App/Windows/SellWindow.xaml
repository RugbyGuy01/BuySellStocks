<Window x:Class="SellSignalLedger.App.Windows.SellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Sell" SizeToContent="Height" Width="380" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
    <StackPanel Margin="20">
        <TextBlock Text="Sell" Style="{StaticResource HeadingText}"/>

        <Label Content="POSITION"/>
        <ComboBox x:Name="PositionCombo" DisplayMemberPath="Display" SelectionChanged="PositionCombo_SelectionChanged"/>

        <TextBlock x:Name="HoldingInfo" Foreground="{StaticResource InkSoftBrush}" Margin="0,0,0,10"/>

        <Label Content="QUANTITY TO SELL"/>
        <TextBox x:Name="QuantityBox"/>

        <Label Content="SELL PRICE PER SHARE"/>
        <TextBox x:Name="PriceBox"/>

        <Label Content="SELL DATE"/>
        <DatePicker x:Name="SellDatePicker"/>

        <TextBlock x:Name="ErrorText" Foreground="{StaticResource LossBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" Style="{StaticResource SecondaryButton}" Foreground="White" Click="Cancel_Click"/>
            <Button Content="Sell" Foreground="White" Click="Sell_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
