<Window x:Class="SellSignalLedger.App.Windows.ImportHoldingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Import Holdings" Height="500" Width="620" WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Import Holdings" Style="{StaticResource HeadingText}"/>

        <TextBlock Grid.Row="1" TextWrapping="Wrap" Foreground="{StaticResource InkSoftBrush}" Margin="0,0,0,12"
                   Text="CSV columns: ticker, quantity, costBasis, purchaseDate (YYYY-MM-DD), then optional mustSellPct, sellProfitPct, sellDropProfitPct. Imported shares don't touch the cash ledger — they weren't bought through the app."/>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,12">
            <Button Content="Choose CSV File..." Foreground="White" Click="Choose_Click"/>
            <TextBlock x:Name="FileNameText" VerticalAlignment="Center" Foreground="{StaticResource InkSoftBrush}"/>
        </StackPanel>

        <DataGrid Grid.Row="3" x:Name="ResultsGrid" ItemsSource="{Binding}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="LINE" Binding="{Binding LineNumber}" Width="50"/>
                <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="80"/>
                <DataGridTextColumn Header="TICKER" Binding="{Binding Ticker}" Width="80"/>
                <DataGridTextColumn Header="DETAIL" Binding="{Binding Detail}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Cancel" Background="{StaticResource LossBrush}" Foreground="White" Click="Close_Click"/>
            <Button Content="Import Valid Rows" Foreground="White" Click="Import_Click"/>
        </StackPanel>
    </Grid>
</Window>
