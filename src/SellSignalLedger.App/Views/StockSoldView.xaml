<UserControl x:Class="SellSignalLedger.App.Views.StockSoldView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Stock Sold" Style="{StaticResource HeadingText}"/>

        <DataGrid Grid.Row="1" x:Name="Grid" ItemsSource="{Binding}">
            <DataGrid.Columns>
                <DataGridTextColumn Header="TICKER" Binding="{Binding Ticker}" Width="80"/>
                <DataGridTextColumn Header="QTY" Binding="{Binding QuantitySold}" Width="55"/>
                <DataGridTextColumn Header="TYPE" Binding="{Binding SaleType}" Width="70"/>
                <DataGridTextColumn Header="BUY DATE" Binding="{Binding BuyDate}" Width="100"/>
                <DataGridTextColumn Header="BUY PRICE" Binding="{Binding BuyPrice}" Width="90"/>
                <DataGridTextColumn Header="SELL DATE" Binding="{Binding SellDate}" Width="100"/>
                <DataGridTextColumn Header="SELL PRICE" Binding="{Binding SellPrice}" Width="90"/>
                <DataGridTextColumn Header="EXIT REASON" Binding="{Binding ExitReason}" Width="110"/>
                <DataGridTemplateColumn Header="REALIZED GAIN/LOSS" Width="170">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding RealizedGainLoss}" Foreground="{Binding RealizedBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="HELD" Binding="{Binding HoldingPeriod}" Width="140"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
