<Window x:Class="SellSignalLedger.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:SellSignalLedger.App.Views"
        Title="Sell-Signal Ledger" Height="760" Width="1200" MinHeight="600" MinWidth="900">
    <DockPanel>
        <Border DockPanel.Dock="Top" Background="{StaticResource InkBrush}" Padding="16,12">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="Sell-Signal Ledger" Foreground="White" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,24,0"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button Content="Import Holdings" Foreground="White" Click="ImportButton_Click"/>
                    <Button Content="Export Holdings" Foreground="White" Click="ExportButton_Click"/>
                    <Button Content="Buy" Foreground="White" Click="BuyButton_Click"/>
                    <Button Content="Sell" Foreground="White" Click="SellButton_Click"/>
                    <Button x:Name="RefreshButton" Content="Refresh Prices Now" Foreground="White" Click="RefreshButton_Click"/>
                </StackPanel>
                <TextBlock/>
            </DockPanel>
        </Border>

        <TabControl>
            <TabItem Header="Dashboard">
                <views:DashboardView x:Name="DashboardTab"/>
            </TabItem>
            <TabItem Header="Owned Stocks">
                <views:OwnedStocksView x:Name="OwnedStocksTab"/>
            </TabItem>
            <TabItem Header="Stock Sold">
                <views:StockSoldView x:Name="StockSoldTab"/>
            </TabItem>
            <TabItem Header="Banking">
                <views:BankingView x:Name="BankingTab"/>
            </TabItem>
            <TabItem Header="Settings">
                <views:SettingsView x:Name="SettingsTab"/>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
