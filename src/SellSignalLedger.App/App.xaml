<Application x:Class="SellSignalLedger.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:SellSignalLedger.App">
    <Application.Resources>
        <ResourceDictionary>

            <SolidColorBrush x:Key="InkBrush" Color="#1C231F"/>
            <SolidColorBrush x:Key="InkSoftBrush" Color="#4B5750"/>
            <SolidColorBrush x:Key="PaperBrush" Color="#EEF1EA"/>
            <SolidColorBrush x:Key="PaperRaisedBrush" Color="#E2E6DC"/>
            <SolidColorBrush x:Key="RuleBrush" Color="#331C231F"/>
            <SolidColorBrush x:Key="AccentBrush" Color="#8F6526"/>
            <SolidColorBrush x:Key="GainBrush" Color="#2F7D54"/>
            <SolidColorBrush x:Key="LossBrush" Color="#A8412F"/>
            <SolidColorBrush x:Key="BlueBrush" Color="#2F5D8A"/>
            <SolidColorBrush x:Key="WhiteBrush" Color="#FFFFFF"/>

            <Style TargetType="Window">
                <Setter Property="Background" Value="{StaticResource PaperBrush}"/>
                <Setter Property="FontFamily" Value="Segoe UI"/>
                <Setter Property="TextElement.Foreground" Value="{StaticResource InkBrush}"/>
            </Style>

            <Style TargetType="TextBlock">
                <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
            </Style>

            <Style x:Key="HeadingText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="20"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Margin" Value="0,0,0,12"/>
            </Style>

            <Style x:Key="EyebrowText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Foreground" Value="{StaticResource InkSoftBrush}"/>
            </Style>

            <Style TargetType="Button">
                <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                <Setter Property="Foreground" Value="White"/>
                <Setter Property="Padding" Value="14,7"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="Margin" Value="0,0,8,0"/>
                <!-- Plain-string Button content gets auto-wrapped in a TextBlock, which would
                     otherwise pick up the app-wide dark TextBlock style (Style Setters beat
                     inherited values). ContentTemplate forces an explicit TextBlock with a
                     hardcoded local Foreground, which no style can override — and it applies
                     whether Content is set in XAML or from code-behind (e.g. RefreshButton's
                     dynamic "Refreshing..." text). -->
                <Setter Property="ContentTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" Foreground="White"/>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Opacity" Value="0.85"/>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Opacity" Value="0.5"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Background" Value="{StaticResource InkBrush}"/>
            </Style>

            <Style TargetType="DataGrid">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="RowBackground" Value="Transparent"/>
                <Setter Property="AlternatingRowBackground" Value="{StaticResource PaperRaisedBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource RuleBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="GridLinesVisibility" Value="Horizontal"/>
                <Setter Property="HorizontalGridLinesBrush" Value="{StaticResource RuleBrush}"/>
                <Setter Property="AutoGenerateColumns" Value="False"/>
                <Setter Property="IsReadOnly" Value="True"/>
                <Setter Property="HeadersVisibility" Value="Column"/>
                <Setter Property="RowHeight" Value="32"/>
                <Setter Property="CanUserAddRows" Value="False"/>
            </Style>

            <Style TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="{StaticResource PaperRaisedBrush}"/>
                <Setter Property="Foreground" Value="{StaticResource InkSoftBrush}"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Padding" Value="10,8"/>
                <Setter Property="BorderBrush" Value="{StaticResource RuleBrush}"/>
                <Setter Property="BorderThickness" Value="0,0,0,1"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
            </Style>

            <Style TargetType="DataGridCell">
                <Setter Property="Padding" Value="10,4"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
                        <Setter Property="Foreground" Value="White"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <Style TargetType="TextBox">
                <Setter Property="Padding" Value="8,6"/>
                <Setter Property="BorderBrush" Value="{StaticResource RuleBrush}"/>
                <Setter Property="Background" Value="White"/>
                <Setter Property="Margin" Value="0,0,0,10"/>
            </Style>

            <Style TargetType="ComboBox">
                <Setter Property="Padding" Value="8,6"/>
                <Setter Property="Margin" Value="0,0,0,10"/>
            </Style>

            <Style TargetType="Label">
                <Setter Property="Foreground" Value="{StaticResource InkSoftBrush}"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Padding" Value="0,0,0,2"/>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>
